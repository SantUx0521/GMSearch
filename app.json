{
  "name": "GMSearch",
  "description": "Aplicación web para búsqueda y gestión de gimnasios",
  "repository": "https://github.com/SantUx0521/Proyecto-pagina-de-gimnasio-",
  "logo": "https://cdn.iconscout.com/icon/free/png-256/free-gym-1-285348.png",
  "keywords": ["django", "gym", "fitness", "python"],
  "env": {
    "SECRET_KEY": {
      "description": "A secret key for Django",
      "generator": "secret"
    },
    "DEBUG": {
      "description": "Debug mode (True/False)",
      "value": "False"
    },
    "SENDGRID_API_KEY": {
      "description": "SendGrid API Key for email sending",
      "required": true
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:mini"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
} 